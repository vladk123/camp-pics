<% layout('/layouts/boilerplate') %>
<link rel="stylesheet" href="/css/adminDashboard.css">
<%- include('../partials/search') %>

<h1>Admin Dashboard</h1>

<section>
  <h2>Recent Uploads</h2>
  <div id="uploads">
    <% uploads.forEach(u => { %>
      <div class="upload-item">
        <div>
          <strong><%= u.mediaType %></strong>
          by <%= u.uploader.fname || 'Unknown' %> (<%= u.uploader.username || '' %>)
          — <%= new Date(u.createdAt).toLocaleString() %>
        </div>
        <div>
          Park: <%= u.parkName || 'N/A' %>
          <% if (u.campgroundName) { %> | CG: <%= u.campgroundName %><% } %>
          <% if (u.campsiteName) { %> | Site: <%= u.campsiteName %><% } %>
        </div>

        <% const youtubeVideoId = extractYouTubeVideoId(u.youtubeId); %>
        <% if (u.mediaType === 'photo' && u.adminPhotoUrl) { %>
            <a href="<%= u.adminPhotoUrl %>" target="_blank" rel="noopener noreferrer">
                <img src="<%= u.adminPhotoUrl %>" class="thumb" alt="photo thumbnail">
            </a>
        <% } else if (u.mediaType === 'video' && youtubeVideoId) { %>
            <a href="https://www.youtube.com/watch?v=<%= youtubeVideoId %>" target="_blank" rel="noopener noreferrer">
                <img src="https://img.youtube.com/vi/<%= youtubeVideoId %>/hqdefault.jpg" class="thumb" alt="YouTube thumbnail">
            </a>
        <% } %>

      </div>
    <% }) %>
  </div>
  <% if (hasMoreUploads) { %>
    <button id="loadMoreUploads">Load more uploads</button>
  <% } %>
</section>

<hr>

<section>
  <h2>Recent Users</h2>
  <div id="users">
    <% users.forEach(u => { %>
      <div class="user-item">
        [<span class="admin-email-status<% if (!u.email_verified) { %> admin-email-status--unverified<% } %>"><%= u.email_verified %>]</span> -
        <strong><%= u.fname %></strong> — <%= u.username %> 
        (joined <%= new Date(u.date_created).toLocaleDateString() %>)
        
        <% if (u.blocked) { %>
          <form action="/a/user/<%= u._id %>/unblock" method="POST" class="inline-form user-status-form" data-action="unblock">
            <%- include('../partials/csrfField') %>
            <button type="submit" class="unblock-btn">Unblock</button>
          </form>
        <% } else { %>
          <form action="/a/user/<%= u._id %>/block" method="POST" class="inline-form user-status-form" data-action="block">
            <%- include('../partials/csrfField') %>
            <button type="submit" class="block-btn">Block</button>
          </form>
        <% } %>
      </div>

    <% }) %>
  </div>
  <% if (hasMoreUsers) { %>
    <button id="loadMoreUsers">Load more users</button>
  <% } %>
</section>

<div
  id="admin-dashboard-state"
  data-upload-page="<%= uploadPage %>"
  data-user-page="<%= userPage %>"
  hidden
></div>

<script src="/js/mediaRendering.js"></script>
<script src="/js/adminDashboard.js"></script>
