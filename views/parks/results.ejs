<% layout('/layouts/boilerplate') %>

<div class="general-max-width margin-auto p50 p0-top">
    
    <h1>Search: '<%= data.query %>'</h1>
    <div><%= data.results.length%> results.</div>
    <%- include('../partials/search') %>
    <div id="park-list">
    <% for (const result of data.results) { %>
        
        <!-- If park -->
        <% if (result.type === 'park') { %>
            <div class="park-result-div">
                <a href="<%= result.destination %>" translate="no">
                    <img src="<%= result.image || '/images/icons/not-found.jpg' %>">

                    <div translate="no"><% for (const segment of result.nameSegments) { %><% if (segment.highlighted) { %><mark><%= segment.text %></mark><% } else { %><%= segment.text %><% } %><% } %></div>

                    <!-- province -->
                    <div class="park-result-province" translate="no">
                        <% for (const segment of result.provinceSegments) { %><% if (segment.highlighted) { %><mark><%= segment.text %></mark><% } else { %><%= segment.text %><% } %><% } %>
                    </div>
                </a>
            </div>

        <!-- If campground -->
        <% } else { %>

            <div class="park-result-div">
                <a href="<%= result.destination %>">
                    <img src="<%= result.image || '/images/icons/not-found.jpg' %>">

                <!-- parent park -->
                    <% for (const segment of result.parentParkSegments) { %><% if (segment.highlighted) { %><mark><%= segment.text %></mark><% } else { %><%= segment.text %><% } %><% } %>

                <!-- campground name -->
                <div class="park-result-campground-name">
                   <% for (const segment of result.nameSegments) { %><% if (segment.highlighted) { %><mark><%= segment.text %></mark><% } else { %><%= segment.text %><% } %><% } %>
                </div> 
                

                <!-- province -->
                <div class="park-result-province">
                    <% for (const segment of result.provinceSegments) { %><% if (segment.highlighted) { %><mark><%= segment.text %></mark><% } else { %><%= segment.text %><% } %><% } %>
                </div>
                </a>
            </div>

        <% } %>

    <% } %>
    </div>

    <% if (!data.results.length) { %>
        <p>No results. Try seeing <a href="/camp/all-parks">all parks</a>.</p>
    <% } %>
</div>
